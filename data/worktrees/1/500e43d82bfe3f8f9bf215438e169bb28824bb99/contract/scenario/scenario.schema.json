{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsb0.dev/contract/v1/scenario.schema.json",
  "title": "JSB0 Reproducible Simulation Scenario v1",
  "description": "Authoritative experiment conditions owned and interpreted by JSB0. Execution variant is supplied separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_type", "name", "aircraft", "initial_condition", "environment", "trim", "simulation", "events", "acceptance"],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_type": {"const": "roll_hold"},
    "name": {"type": "string", "minLength": 1},
    "aircraft": {"type": "string", "enum": ["c172x"]},
    "initial_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude_deg", "longitude_deg", "altitude_ft", "airspeed_kts", "roll_deg", "pitch_deg", "heading_deg", "p_rad_s", "q_rad_s", "r_rad_s"],
      "properties": {
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90, "description": "Geodetic latitude [deg], north positive."},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180, "description": "Geodetic longitude [deg], east positive."},
        "altitude_ft": {"type": "number", "description": "Altitude above mean sea level [ft]."},
        "airspeed_kts": {"type": "number", "minimum": 0, "description": "Calibrated initial airspeed [kt]."},
        "roll_deg": {"type": "number", "description": "3-2-1 Euler roll [deg], right-hand positive."},
        "pitch_deg": {"type": "number", "description": "3-2-1 Euler pitch [deg], nose-up positive."},
        "heading_deg": {"type": "number", "description": "True heading [deg], clockwise from north."},
        "p_rad_s": {"type": "number", "description": "Body x-axis angular rate [rad/s], right-hand positive."},
        "q_rad_s": {"type": "number", "description": "Body y-axis angular rate [rad/s], right-hand positive."},
        "r_rad_s": {"type": "number", "description": "Body z-axis angular rate [rad/s], right-hand positive."}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wind_enabled"],
      "properties": {"wind_enabled": {"const": false, "description": "v1 requires still-air execution; future explicit wind fields require a contract revision."}}
    },
    "trim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["Longitudinal", "Full", "Ground"]}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_sec", "dt_sec"],
      "properties": {
        "duration_sec": {"type": "number", "exclusiveMinimum": 0, "description": "Requested simulation duration [s]."},
        "dt_sec": {"type": "number", "exclusiveMinimum": 0, "description": "Fixed simulation timestep [s]."}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time_sec", "command"],
        "properties": {
          "time_sec": {"type": "number", "minimum": 0, "description": "Simulation time at which this command is applied [s]."},
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "roll_deg"],
            "properties": {
              "type": {"const": "roll_hold"},
              "roll_deg": {"type": "number", "description": "Commanded 3-2-1 Euler roll [deg], right-hand positive."}
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settling_band_deg", "settling_time_limit_sec", "overshoot_limit_deg", "max_oscillation_cycles"],
      "properties": {
        "settling_band_deg": {"type": "number", "minimum": 0},
        "settling_time_limit_sec": {"type": "number", "minimum": 0},
        "overshoot_limit_deg": {"type": "number", "minimum": 0},
        "max_oscillation_cycles": {"type": "number", "minimum": 0}
      }
    }
  }
}
