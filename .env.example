JSB1_DATA_DIR=./data
JSB1_DATABASE_PATH=./data/jsb1.db
JSB_SIM_RUNNER_PATH=./bin/jsb-sim-runner
JSB_SCENARIO_DIR=../jsb0/scenarios
JSB1_MAX_CONCURRENT_RUNS=1
JSB1_RUN_TIMEOUT_SEC=1800
JSB1_REPOSITORY_ROOT=./data/repositories
JSB1_RUNTIME_REPOSITORY_NAME=jsb0
JSB1_WORKTREE_ROOT=./data/worktrees
JSB1_BUILD_ROOT=./data/builds
JSB1_MAX_CONCURRENT_BUILDS=1
JSB1_BUILD_JOBS=2
JSB1_BUILD_TIMEOUT_SEC=3600
JSB1_BUILD_EXECUTABLE_RELATIVE_PATH=jsb-sim-runner
JSB1_AUTOPILOTS=["baseline","primary"]
JSB1_CORS_ORIGINS=["http://localhost:5173"]

# Branch preview deployments. Keep certificate/key files outside this repository.
JSB1_DEPLOYMENT_BASE_DOMAIN=mangagaki.net
JSB1_DEPLOYMENT_MAIN_HOSTNAME=jsb.mangagaki.net
JSB1_DEPLOYMENT_MAIN_BRANCH=main
JSB1_DEPLOYMENT_PORT_START=8100
JSB1_DEPLOYMENT_PORT_END=8999
JSB1_DEPLOYMENT_HEALTH_TIMEOUT_SEC=120
JSB1_DEPLOYMENT_HEALTH_INTERVAL_SEC=2
JSB1_DEPLOYMENT_HTTPS_PORT=443
JSB1_DEPLOYMENT_PUBLIC_TIMEOUT_SEC=180
# Containerized controller overrides both hosts with host.docker.internal.
# JSB1_DEPLOYMENT_HEALTH_HOST=127.0.0.1
# JSB1_DEPLOYMENT_PORT_PROBE_HOST=127.0.0.1
# JSB1_TLS_CERT_PATH=/etc/cloudflare/jsb-origin.pem
# JSB1_TLS_KEY_PATH=/etc/cloudflare/jsb-origin.key
# JSB1_HOST_PROJECT_ROOT=/absolute/host/path/to/jsb1
# JSB1_CADDY_CONFIG_PATH=./data/caddy/Caddyfile
# JSB1_CADDY_FRAGMENTS_DIR=./data/caddy/deployments
# JSB1_CADDY_CONTAINER=jsb1-preview-edge
# JSB1_CADDY_UPSTREAM_HOST=host.docker.internal
# JSB1_CADDY_HEALTH_HOST=edge

# CLI branch deployment helpers (paths only; never put key contents here).
# JSB1_TLS_CERT_PATH=/Users/yang/.cloudflare/jsb-origin.pem
# JSB1_TLS_KEY_PATH=/Users/yang/.cloudflare/jsb-origin.key
# JSB1_DEPLOY_STATE_DIR=/absolute/path/outside-or-beneath-ignored-data
# JSB1_EDGE_HTTPS_PORT=4443
# JSB1_CLOUDFLARE_TUNNEL=jsb1
# JSB1_CLOUDFLARED_ORIGIN_CERT=/Users/yang/.cloudflared/cert.pem
# JSB1_CLOUDFLARED_CREDENTIALS=/Users/yang/.cloudflared/<tunnel-id>.json
# Automatic preview deployment safety controls.
# JSB1_AUTO_DEPLOY_MAIN=false
# JSB1_AUTO_DEPLOY_RETRY_SEC=300
# JSB1_STALE_BRANCH_GRACE_SEC=86400
# GitHub Deployment reporting is optional. Keep JSB1_GITHUB_TOKEN in the host
# process environment; never put its value in this repository or Docker config.
# JSB1_GITHUB_REPOSITORY=egod1537/jsb1
# JSB1_GITHUB_DEPLOYMENT_REQUIRED=false
# Optional: only set this when JSB1 uses a dedicated buildx builder.
# JSB1_DEPLOY_BUILDER=jsb1-deploy
# Optional alternative to the existing cloudflared login credential.
# CLOUDFLARE_API_TOKEN=<token with Zone:Read and DNS:Edit>
